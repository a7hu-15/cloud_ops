# CloudOps Lab Environment Variables Example
# Copy this file to .env for custom local settings. Never commit real credentials.

# Application Environment (development | production)
ENV=development

# Database Path (defaults to backend/cloudops.db)
CLOUDOPS_DB_PATH=backend/cloudops.db

# Frontend URL (for email verification and password reset links)
FRONTEND_BASE_URL=http://localhost:5173

# Optional SMTP Configuration (leave empty for local development console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@cloudops-lab.local

# AWS Region (AWS credentials should be managed via AWS CLI or IAM role, not plaintext in .env)
AWS_DEFAULT_REGION=us-east-1

